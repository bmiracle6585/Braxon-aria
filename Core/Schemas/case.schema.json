{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria.braxon.ai/schemas/case.schema.json",
  "title": "A.R.I.A. Diagnostic Case",
  "description": "Machine-readable validation schema for an A.R.I.A. diagnostic or operational case. A case represents an investigation or work episode and remains distinct from validated Experience Ledger records that may later be derived from it.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "case_id",
    "case_type",
    "status",
    "opened_at",
    "created_at",
    "updated_at"
  ],

  "properties": {
    "case_id": {
      "$ref": "#/$defs/case_id"
    },

    "case_type": {
      "type": "string",
      "enum": [
        "TROUBLESHOOTING",
        "COMMISSIONING",
        "INSTALLATION",
        "ALIGNMENT",
        "CONFIGURATION",
        "DESIGN",
        "MAINTENANCE",
        "VALIDATION",
        "TRAINING",
        "OTHER"
      ]
    },

    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "ACTIVE",
        "WAITING",
        "RESOLVED",
        "CLOSED",
        "REOPENED",
        "INVALIDATED"
      ]
    },

    "title": {
      "type": ["string", "null"],
      "maxLength": 500
    },

    "summary": {
      "type": ["string", "null"]
    },

    "context_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/context_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical context object associated with this case when one has been materialized."
    },

    "context": {
      "type": "object",
      "description": "Case-local context references used for efficient reasoning and retrieval. Canonical concepts remain independently addressable entities.",
      "additionalProperties": false,

      "properties": {
        "manufacturer_ids": {
          "$ref": "#/$defs/manufacturer_id_array"
        },

        "product_family_ids": {
          "$ref": "#/$defs/product_family_id_array"
        },

        "product_ids": {
          "$ref": "#/$defs/product_id_array"
        },

        "product_variant_ids": {
          "$ref": "#/$defs/product_variant_id_array"
        },

        "hardware_revision_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "firmware_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "frequency_band_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "configuration_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "topology_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "scope_ids": {
          "$ref": "#/$defs/scope_id_array"
        },

        "project_phase_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "environment_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "customer_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "site_a": {
          "type": ["string", "null"]
        },

        "site_b": {
          "type": ["string", "null"]
        },

        "project_identifier": {
          "type": ["string", "null"]
        },

        "link_identifier": {
          "type": ["string", "null"]
        }
      }
    },

    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/participant"
      },
      "default": []
    },

    "symptom_ids": {
      "$ref": "#/$defs/symptom_id_array"
    },

    "reported_problem": {
      "type": ["string", "null"],
      "description": "Problem as initially reported, preserved separately from ARIA's hypotheses and final diagnosis."
    },

    "initial_conditions": {
      "type": ["string", "null"]
    },

    "evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "hypothesis_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hypothesis_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "route_step_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route_step_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "event_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "action_ids": {
      "type": "array",
      "description": "Canonical Action entities associated with the case, including diagnostic, verification, and corrective actions.",
      "items": {
        "$ref": "#/$defs/action_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "diagnosis": {
      "type": ["object", "null"],
      "additionalProperties": false,

      "properties": {
        "primary_cause_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/typed_entity_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "contributing_cause_ids": {
          "$ref": "#/$defs/generic_typed_id_array"
        },

        "failure_mode_ids": {
          "$ref": "#/$defs/failure_mode_id_array"
        },

        "diagnosis_text": {
          "type": ["string", "null"]
        },

        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },

        "confirmed": {
          "type": "boolean",
          "default": false
        },

        "confirmation_method": {
          "type": ["string", "null"]
        },

        "confirmation_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },

        "confirmed_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_id"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },

    "corrective_actions": {
      "type": "array",
      "description": "Case-local summaries of corrective actions. action_id references the canonical Action entity and remains the authoritative identity.",
      "items": {
        "$ref": "#/$defs/corrective_action"
      },
      "default": []
    },

    "outcome": {
      "type": ["object", "null"],
      "additionalProperties": false,

      "properties": {
        "outcome_ids": {
          "$ref": "#/$defs/outcome_id_array"
        },

        "resolution_status": {
          "type": ["string", "null"],
          "enum": [
            "RESOLVED",
            "PARTIALLY_RESOLVED",
            "UNRESOLVED",
            "NO_FAULT_FOUND",
            "ESCALATED",
            "INVALID_CASE",
            null
          ]
        },

        "resolution_text": {
          "type": ["string", "null"]
        },

        "validated": {
          "type": "boolean",
          "default": false
        },

        "validation_method": {
          "type": ["string", "null"]
        },

        "validation_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "validated_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_id"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },

        "validated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },

    "learning": {
      "type": "object",
      "description": "Learning eligibility and derivation state. A diagnostic case does not itself constitute an Experience Ledger record. Experience records may be derived only when the applicable learning and validation requirements are satisfied.",
      "additionalProperties": false,

      "properties": {
        "eligible_for_learning": {
          "type": "boolean",
          "default": false
        },

        "learning_status": {
          "type": "string",
          "enum": [
            "NOT_EVALUATED",
            "INELIGIBLE",
            "ELIGIBLE",
            "PROCESSED",
            "REQUIRES_REVIEW"
          ],
          "default": "NOT_EVALUATED"
        },

        "generated_claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "derived_experience_ids": {
          "type": "array",
          "description": "Validated Experience Ledger records derived from this case. These are separate entities from the case itself.",
          "items": {
            "$ref": "#/$defs/experience_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "similar_case_ids": {
          "type": "array",
          "description": "Other diagnostic cases considered materially comparable during learning or historical analysis.",
          "items": {
            "$ref": "#/$defs/case_id"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "resolution_metrics": {
      "type": "object",
      "additionalProperties": false,

      "properties": {
        "time_to_resolution_seconds": {
          "type": ["integer", "null"],
          "minimum": 0
        },

        "diagnostic_steps": {
          "type": ["integer", "null"],
          "minimum": 0
        },

        "tests_performed": {
          "type": ["integer", "null"],
          "minimum": 0
        },

        "hypotheses_considered": {
          "type": ["integer", "null"],
          "minimum": 0
        },

        "route_changes": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },

    "opened_at": {
      "type": "string",
      "format": "date-time"
    },

    "resolved_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },

    "closed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    },

    "created_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/user_id"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },

    "updated_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/user_id"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },

    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "case_id": {
      "type": "string",
      "pattern": "^case_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "context_id": {
      "type": "string",
      "pattern": "^ctx_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "evidence_id": {
      "type": "string",
      "pattern": "^evd_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "hypothesis_id": {
      "type": "string",
      "pattern": "^hyp_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "route_step_id": {
      "type": "string",
      "pattern": "^rstep_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "action_id": {
      "type": "string",
      "pattern": "^act_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "claim_id": {
      "type": "string",
      "pattern": "^claim_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "experience_id": {
      "type": "string",
      "pattern": "^exp_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "user_id": {
      "type": "string",
      "pattern": "^usr_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "manufacturer_id": {
      "type": "string",
      "pattern": "^mfr_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "product_family_id": {
      "type": "string",
      "pattern": "^pfam_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "product_id": {
      "type": "string",
      "pattern": "^prod_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "product_variant_id": {
      "type": "string",
      "pattern": "^pvar_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "scope_id": {
      "type": "string",
      "pattern": "^scope_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "symptom_id": {
      "type": "string",
      "pattern": "^sym_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "failure_mode_id": {
      "type": "string",
      "pattern": "^fm_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "outcome_id": {
      "type": "string",
      "pattern": "^out_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "typed_entity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "generic_typed_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typed_entity_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "manufacturer_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manufacturer_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "product_family_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_family_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "product_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "product_variant_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_variant_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "scope_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "symptom_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symptom_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "failure_mode_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failure_mode_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "outcome_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/outcome_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "participant": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "user_id",
        "roles"
      ],

      "properties": {
        "user_id": {
          "$ref": "#/$defs/user_id"
        },

        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "REPORTER",
              "OBSERVER",
              "INSTALLER",
              "CONFIGURATOR",
              "ALIGNER",
              "TESTER",
              "TROUBLESHOOTER",
              "DIAGNOSTICIAN",
              "CORRECTIVE_ACTION_PERFORMER",
              "VALIDATOR",
              "SUPERVISOR",
              "OTHER"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      }
    },

    "corrective_action": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "action_id"
      ],

      "properties": {
        "action_id": {
          "$ref": "#/$defs/action_id"
        },

        "corrective_action_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/typed_entity_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "description": {
          "type": ["string", "null"]
        },

        "performed_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_id"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },

        "performed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },

        "successful": {
          "type": ["boolean", "null"]
        },

        "resulting_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    }
  }
}
