{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria.braxon.ai/schemas/evidence.schema.json",
  "title": "A.R.I.A. Case Evidence",
  "description": "Machine-readable validation schema for observations, measurements, test results, artifacts, configuration data, documentary information, and other evidence associated with an active or historical A.R.I.A. diagnostic case. Evidence remains distinct from interpretation and inference, retains provenance, and references the canonical entities to which it applies.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "evidence_id",
    "case_id",
    "evidence_type",
    "status",
    "provenance",
    "observed_at",
    "created_at",
    "updated_at"
  ],

  "properties": {
    "evidence_id": {
      "$ref": "#/$defs/evidence_id"
    },

    "case_id": {
      "$ref": "#/$defs/case_id",
      "description": "Diagnostic case to which this evidence belongs. A diagnostic case is distinct from an Experience Ledger record."
    },

    "evidence_type": {
      "type": "string",
      "enum": [
        "USER_OBSERVATION",
        "TECHNICIAN_OBSERVATION",
        "DIRECT_MEASUREMENT",
        "INSTRUMENT_MEASUREMENT",
        "SYSTEM_READING",
        "CONFIGURATION_VALUE",
        "CONFIGURATION_EXPORT",
        "TEST_RESULT",
        "ALARM",
        "LOG_ENTRY",
        "SCREENSHOT",
        "PHOTOGRAPH",
        "VIDEO",
        "DOCUMENT",
        "DESIGN_VALUE",
        "EXPECTED_VALUE",
        "ENVIRONMENTAL_OBSERVATION",
        "PHYSICAL_INSPECTION",
        "SYSTEM_INFERENCE",
        "OTHER"
      ]
    },

    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "INVALIDATED",
        "RETRACTED"
      ]
    },

    "observation": {
      "type": ["string", "null"],
      "description": "Human-readable statement describing what was directly observed, measured, recorded, or supplied by the originating source."
    },

    "interpretation": {
      "type": ["string", "null"],
      "description": "Interpretation of the observation. Interpretation shall remain distinguishable from the underlying observation and shall not acquire the authority of the source evidence."
    },

    "measurement_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/measurement_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical measurement concept represented by this evidence when applicable."
    },

    "value": {
      "description": "Observed value. May be numeric, textual, boolean, or null depending on evidence type.",
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },

    "unit_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/unit_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical unit associated with the observed value when applicable."
    },

    "expected_value": {
      "description": "Expected, engineered, configured, required, or reference value when applicable.",
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },

    "expected_unit_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/unit_id"
        },
        {
          "type": "null"
        }
      ]
    },

    "comparison": {
      "type": ["object", "null"],
      "description": "Structured comparison between observed and expected conditions.",
      "additionalProperties": false,

      "properties": {
        "difference": {
          "type": ["number", "null"]
        },

        "absolute_difference": {
          "type": ["number", "null"],
          "minimum": 0
        },

        "within_tolerance": {
          "type": ["boolean", "null"]
        },

        "tolerance": {
          "type": ["number", "null"],
          "minimum": 0
        },

        "comparison_result": {
          "type": ["string", "null"],
          "enum": [
            "MATCH",
            "ABOVE_EXPECTED",
            "BELOW_EXPECTED",
            "WITHIN_TOLERANCE",
            "OUTSIDE_TOLERANCE",
            "DIFFERENT",
            "UNKNOWN",
            null
          ]
        }
      }
    },

    "subject_entity_ids": {
      "$ref": "#/$defs/typed_entity_id_array",
      "description": "Canonical entities directly described, measured, observed, or otherwise represented by this evidence."
    },

    "context_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/context_id"
        },
        {
          "type": "null"
        }
      ]
    },

    "context": {
      "type": "object",
      "description": "Evidence-local technical context. These references assist reasoning without duplicating canonical knowledge entities.",
      "additionalProperties": false,

      "properties": {
        "manufacturer_ids": {
          "$ref": "#/$defs/manufacturer_id_array"
        },

        "product_family_ids": {
          "$ref": "#/$defs/product_family_id_array"
        },

        "product_ids": {
          "$ref": "#/$defs/product_id_array"
        },

        "product_variant_ids": {
          "$ref": "#/$defs/product_variant_id_array"
        },

        "hardware_revision_ids": {
          "$ref": "#/$defs/typed_entity_id_array"
        },

        "firmware_ids": {
          "$ref": "#/$defs/typed_entity_id_array"
        },

        "frequency_band_ids": {
          "$ref": "#/$defs/typed_entity_id_array"
        },

        "configuration_ids": {
          "$ref": "#/$defs/typed_entity_id_array"
        },

        "topology_ids": {
          "$ref": "#/$defs/typed_entity_id_array"
        },

        "scope_ids": {
          "$ref": "#/$defs/scope_id_array"
        },

        "symptom_ids": {
          "$ref": "#/$defs/symptom_id_array"
        },

        "site": {
          "type": ["string", "null"]
        },

        "side": {
          "type": ["string", "null"],
          "description": "Optional path or system side such as Main, Diversity, Radio A, Radio B, Site A, or Site B."
        }
      }
    },

    "observer": {
      "type": ["object", "null"],
      "description": "Person or system responsible for the underlying observation.",
      "additionalProperties": false,

      "properties": {
        "user_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "role": {
          "type": ["string", "null"]
        },

        "system_identifier": {
          "type": ["string", "null"]
        }
      }
    },

    "reporter": {
      "type": ["object", "null"],
      "description": "Person or system that supplied the evidence to ARIA when different from the original observer.",
      "additionalProperties": false,

      "properties": {
        "user_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "role": {
          "type": ["string", "null"]
        },

        "system_identifier": {
          "type": ["string", "null"]
        }
      }
    },

    "collection_method": {
      "type": ["string", "null"],
      "enum": [
        "DIRECT_OBSERVATION",
        "MANUAL_ENTRY",
        "INSTRUMENT",
        "SYSTEM_API",
        "CONFIGURATION_EXPORT",
        "SCREEN_CAPTURE",
        "PHOTO_CAPTURE",
        "VIDEO_CAPTURE",
        "LOG_EXTRACTION",
        "DOCUMENT_EXTRACTION",
        "MODEL_INTERPRETATION",
        "SYSTEM_DERIVATION",
        null
      ]
    },

    "instrument": {
      "type": ["object", "null"],
      "description": "Measurement instrument information when applicable.",
      "additionalProperties": false,

      "properties": {
        "tool_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/tool_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "manufacturer_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/manufacturer_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "manufacturer": {
          "type": ["string", "null"]
        },

        "model": {
          "type": ["string", "null"]
        },

        "serial_number": {
          "type": ["string", "null"]
        },

        "calibration_status": {
          "type": ["string", "null"],
          "enum": [
            "CURRENT",
            "EXPIRED",
            "UNKNOWN",
            "NOT_APPLICABLE",
            null
          ]
        },

        "calibration_due_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },

    "artifact": {
      "type": ["object", "null"],
      "description": "Artifact supporting or containing the evidence.",
      "additionalProperties": false,

      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "storage_location": {
          "type": ["string", "null"]
        },

        "original_filename": {
          "type": ["string", "null"]
        },

        "media_type": {
          "type": ["string", "null"]
        },

        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },

    "provenance": {
      "$ref": "#/$defs/provenance",
      "description": "Required lineage information identifying where this evidence came from and whether it is primary, copied, transformed, derived, inferred, aggregated, or summarized."
    },

    "reliability": {
      "type": "object",
      "description": "Structured assessment of evidence reliability. Reliability concerns trust in this evidence record and remains distinct from hypothesis probability.",
      "additionalProperties": false,

      "properties": {
        "observation_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },

        "measurement_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },

        "context_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },

        "overall_confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/confidence"
            },
            {
              "type": "null"
            }
          ]
        },

        "independence": {
          "type": "string",
          "enum": [
            "INDEPENDENT",
            "PARTIALLY_INDEPENDENT",
            "DEPENDENT",
            "SAME_SOURCE",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        },

        "independence_group_id": {
          "type": ["string", "null"],
          "description": "Stable grouping identifier for evidence records that originate from the same underlying observation or source."
        },

        "independently_verified": {
          "type": "boolean",
          "default": false
        }
      }
    },

    "verification": {
      "type": "object",
      "description": "Independent verification of this evidence when available.",
      "additionalProperties": false,

      "properties": {
        "verified": {
          "type": "boolean",
          "default": false
        },

        "verified_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/user_id"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },

        "verified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },

        "verification_method": {
          "type": ["string", "null"]
        },

        "verification_notes": {
          "type": ["string", "null"]
        }
      }
    },

    "supporting_relationship_ids": {
      "type": "array",
      "description": "Canonical relationship records expressing how this evidence supports claims, hypotheses, or other entities. Relationship records are authoritative for relationship semantics.",
      "items": {
        "$ref": "#/$defs/relationship_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "supports_hypothesis_ids": {
      "type": "array",
      "description": "Convenience index of hypotheses currently supported by this evidence. Canonical relationship records remain authoritative for support semantics and strength.",
      "items": {
        "$ref": "#/$defs/hypothesis_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "contradicts_hypothesis_ids": {
      "type": "array",
      "description": "Convenience index of hypotheses currently contradicted by this evidence. Canonical relationship records remain authoritative for contradiction semantics and strength.",
      "items": {
        "$ref": "#/$defs/hypothesis_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "derived_from_evidence_ids": {
      "type": "array",
      "description": "Evidence records materially used to derive this evidence. Derived evidence does not become independent merely because it is stored as a separate record.",
      "items": {
        "$ref": "#/$defs/evidence_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "supersedes_evidence_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "superseded_by_evidence_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/evidence_id"
        },
        {
          "type": "null"
        }
      ]
    },

    "observed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time the underlying condition was observed or measured."
    },

    "received_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Time ARIA received the evidence when different from observation time."
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    },

    "created_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/user_id"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },

    "updated_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/user_id"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },

    "metadata": {
      "type": "object",
      "description": "Controlled extensibility for evidence-type-specific metadata.",
      "additionalProperties": true
    }
  },

  "$defs": {
    "case_id": {
      "type": "string",
      "pattern": "^case_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "context_id": {
      "type": "string",
      "pattern": "^ctx_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "evidence_id": {
      "type": "string",
      "pattern": "^evd_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "hypothesis_id": {
      "type": "string",
      "pattern": "^hyp_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "relationship_id": {
      "type": "string",
      "pattern": "^rel_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "user_id": {
      "type": "string",
      "pattern": "^usr_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "manufacturer_id": {
      "type": "string",
      "pattern": "^mfr_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "product_family_id": {
      "type": "string",
      "pattern": "^pfam_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "product_id": {
      "type": "string",
      "pattern": "^prod_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "product_variant_id": {
      "type": "string",
      "pattern": "^pvar_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "scope_id": {
      "type": "string",
      "pattern": "^scope_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "symptom_id": {
      "type": "string",
      "pattern": "^sym_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "measurement_id": {
      "type": "string",
      "pattern": "^meas_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "unit_id": {
      "type": "string",
      "pattern": "^unit_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "tool_id": {
      "type": "string",
      "pattern": "^tool_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "artifact_id": {
      "type": "string",
      "pattern": "^artifact_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "typed_entity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },

    "typed_entity_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typed_entity_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "manufacturer_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manufacturer_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "product_family_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_family_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "product_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "product_variant_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/product_variant_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "scope_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scope_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "symptom_id_array": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symptom_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": false,

      "required": [
        "source_type",
        "lineage_type"
      ],

      "properties": {
        "source_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/source_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "source_type": {
          "type": "string",
          "enum": [
            "MANUFACTURER_DOCUMENT",
            "MANUFACTURER_SUPPORT",
            "ENGINEERING_DOCUMENT",
            "ENGINEERING_APPROVAL",
            "STANDARD",
            "CUSTOMER_DOCUMENT",
            "PROJECT_DOCUMENT",
            "DESIGN_DOCUMENT",
            "CONFIGURATION_EXPORT",
            "EQUIPMENT_TELEMETRY",
            "DIRECT_MEASUREMENT",
            "TEST_EQUIPMENT_OUTPUT",
            "ALARM",
            "LOG",
            "SCREENSHOT",
            "PHOTO",
            "VIDEO",
            "USER_STATEMENT",
            "USER_OBSERVATION",
            "USER_INTERPRETATION",
            "TECHNICIAN_ACTION_RESULT",
            "HISTORICAL_CASE",
            "EXPERIENCE_LEDGER",
            "EXTERNAL_SYSTEM",
            "ARIA_DERIVATION",
            "ARIA_INFERENCE",
            "ARIA_SUMMARY",
            "ARIA_CALCULATION",
            "ARIA_PATTERN",
            "UNKNOWN_SOURCE"
          ]
        },

        "lineage_type": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "COPIED",
            "TRANSFORMED",
            "DERIVED",
            "INFERRED",
            "AGGREGATED",
            "SUMMARIZED"
          ]
        },

        "parent_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "original_source_reference": {
          "type": ["string", "null"]
        },

        "acquired_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },

        "integrity_status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "HASH_VERIFIED",
            "PARTIALLY_VERIFIED",
            "UNVERIFIED",
            "ALTERED",
            "CORRUPTED",
            "INCOMPLETE",
            "UNKNOWN"
          ],
          "default": "UNKNOWN"
        }
      }
    }
  }
}
