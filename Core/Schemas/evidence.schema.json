{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aria.braxon.ai/schemas/evidence.schema.json",
  "title": "A.R.I.A. Case Evidence",
  "description": "Authoritative persistence schema for case-specific technical evidence used by A.R.I.A. Evidence records what was observed, measured, reported, retrieved, captured, tested, calculated, or otherwise established for a technical case. Evidence remains distinct from interpretation, inference, hypothesis, diagnosis, canonical knowledge, historical experience, and source authority.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "evidence_id",
    "case_id",
    "evidence_type",
    "status",
    "provenance",
    "created_at",
    "updated_at"
  ],

  "properties": {
    "evidence_id": {
      "$ref": "#/$defs/evidence_id"
    },

    "case_id": {
      "$ref": "#/$defs/case_id",
      "description": "Diagnostic case to which this evidence belongs."
    },

    "evidence_type": {
      "type": "string",
      "description": "Controlled evidence classification governed by Core/Registries/evidence_types.json. This schema intentionally does not duplicate the Registry's complete evidence-type vocabulary."
    },

    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "INVALIDATED",
        "RETRACTED"
      ],
      "description": "Persistence state of the evidence record. Status does not encode diagnostic support, contradiction, confidence, or hypothesis disposition."
    },

    "observation": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable statement of what was observed, measured, reported, retrieved, captured, tested, calculated, or otherwise established. Observation shall remain distinguishable from interpretation."
    },

    "interpretation": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional interpretation of the underlying evidence. Interpretation does not acquire the authority of the underlying observation and shall not replace it."
    },

    "value": {
      "description": "Observed or established scalar value when the evidence can be represented directly as a scalar.",
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },

    "measurement_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/measurement_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical measurement record represented or supported by this evidence when applicable."
    },

    "unit_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/unit_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Canonical unit associated with a scalar evidence value when applicable."
    },

    "expected_value": {
      "description": "Expected, engineered, configured, required, baseline, or reference scalar value when materially relevant.",
      "type": [
        "number",
        "string",
        "boolean",
        "null"
      ]
    },

    "expected_unit_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/unit_id"
        },
        {
          "type": "null"
        }
      ]
    },

    "comparison": {
      "$ref": "#/$defs/comparison"
    },

    "subject_entity_ids": {
      "type": "array",
      "description": "Canonical technical entities directly described, measured, observed, tested, or otherwise represented by this evidence.",
      "items": {
        "$ref": "#/$defs/runtime_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "context_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/context_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Authoritative persisted technical context applicable to this evidence. Context structure is owned by Core/Schemas/context.schema.json."
    },

    "source_ids": {
      "type": "array",
      "description": "Source records materially supporting or containing this evidence.",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "artifact_ids": {
      "type": "array",
      "description": "Artifacts containing, supporting, or preserving this evidence.",
      "items": {
        "$ref": "#/$defs/artifact_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "observer": {
      "$ref": "#/$defs/actor_reference"
    },

    "reporter": {
      "$ref": "#/$defs/actor_reference"
    },

    "collection_method": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DIRECT_OBSERVATION",
        "MANUAL_ENTRY",
        "INSTRUMENT",
        "SYSTEM_API",
        "SYSTEM_INTERFACE",
        "CONFIGURATION_RETRIEVAL",
        "CONFIGURATION_EXPORT",
        "SCREEN_CAPTURE",
        "PHOTO_CAPTURE",
        "VIDEO_CAPTURE",
        "LOG_EXTRACTION",
        "DOCUMENT_EXTRACTION",
        "TEST_EXECUTION",
        "ACTION_OBSERVATION",
        "DETERMINISTIC_CALCULATION",
        "SYSTEM_DERIVATION",
        null
      ],
      "description": "Method by which the evidence was obtained. Model interpretation is intentionally excluded because inference is not an evidence collection method."
    },

    "instrument": {
      "$ref": "#/$defs/instrument_reference"
    },

    "test": {
      "$ref": "#/$defs/test_record"
    },

    "change_result": {
      "$ref": "#/$defs/change_result"
    },

    "derivation": {
      "$ref": "#/$defs/derivation"
    },

    "provenance": {
      "$ref": "#/$defs/provenance"
    },

    "confidence": {
      "$ref": "#/$defs/confidence",
      "description": "Confidence in the evidence record represented according to the shared confidence contract in Core/Schemas/core_contracts.json. This is distinct from source authority, context-match confidence, and hypothesis probability."
    },

    "verification": {
      "$ref": "#/$defs/verification"
    },

    "diagnostic_links": {
      "type": "array",
      "description": "Case-specific diagnostic relationships between this evidence and hypotheses. Diagnostic role is relationship-specific rather than an immutable property of the evidence.",
      "items": {
        "$ref": "#/$defs/diagnostic_link"
      },
      "default": []
    },

    "supporting_relationship_ids": {
      "type": "array",
      "description": "Canonical relationship records associated with this evidence. Relationship records remain authoritative for relationship semantics.",
      "items": {
        "$ref": "#/$defs/relationship_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "derived_from_evidence_ids": {
      "type": "array",
      "description": "Evidence records materially used to derive this evidence. Derived evidence does not become independent merely because it is persisted separately.",
      "items": {
        "$ref": "#/$defs/evidence_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "supersedes_evidence_ids": {
      "type": "array",
      "description": "Earlier evidence records superseded by this record.",
      "items": {
        "$ref": "#/$defs/evidence_id"
      },
      "uniqueItems": true,
      "default": []
    },

    "superseded_by_evidence_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/evidence_id"
        },
        {
          "type": "null"
        }
      ]
    },

    "observed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Time at which the represented technical condition was observed or occurred when known."
    },

    "collected_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Time at which the evidence was collected when distinct from the underlying observation time."
    },

    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Beginning of the period during which the evidence is known or asserted to describe the applicable technical state."
    },

    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "End of the period during which the evidence is known or asserted to describe the applicable technical state."
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    },

    "updated_at": {
      "type": "string",
      "format": "date-time"
    },

    "created_by": {
      "type": [
        "string",
        "null"
      ]
    },

    "updated_by": {
      "type": [
        "string",
        "null"
      ]
    },

    "notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable technical notes that do not replace structured evidence, provenance, context, or reasoning relationships."
    },

    "metadata": {
      "type": "object",
      "description": "Non-authoritative extensibility metadata. Canonical technical meaning shall not depend on metadata fields.",
      "additionalProperties": true,
      "default": {}
    }
  },

  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "runtime_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "evidence_id": {
      "type": "string",
      "pattern": "^evd_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "case_id": {
      "type": "string",
      "pattern": "^case_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "context_id": {
      "type": "string",
      "pattern": "^ctx_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "measurement_id": {
      "type": "string",
      "pattern": "^meas_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "unit_id": {
      "type": "string",
      "pattern": "^unit_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "source_id": {
      "type": "string",
      "pattern": "^src_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "artifact_id": {
      "type": "string",
      "pattern": "^art_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "tool_id": {
      "type": "string",
      "pattern": "^tool_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "action_id": {
      "type": "string",
      "pattern": "^act_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "hypothesis_id": {
      "type": "string",
      "pattern": "^hyp_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "relationship_id": {
      "type": "string",
      "pattern": "^rel_[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },

    "comparison": {
      "type": [
        "object",
        "null"
      ],
      "description": "Structured comparison between observed and expected or reference conditions.",
      "additionalProperties": false,

      "properties": {
        "difference": {
          "type": [
            "number",
            "null"
          ]
        },

        "absolute_difference": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "within_tolerance": {
          "type": [
            "boolean",
            "null"
          ]
        },

        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },

        "comparison_result": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "MATCH",
            "ABOVE_EXPECTED",
            "BELOW_EXPECTED",
            "WITHIN_TOLERANCE",
            "OUTSIDE_TOLERANCE",
            "DIFFERENT",
            "UNKNOWN",
            "NOT_APPLICABLE",
            null
          ]
        }
      }
    },

    "actor_reference": {
      "type": [
        "object",
        "null"
      ],
      "description": "Person, system, or technical actor associated with observation or reporting.",
      "additionalProperties": false,

      "properties": {
        "actor_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtime_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "actor_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "USER",
            "TECHNICIAN",
            "ENGINEER",
            "SYSTEM",
            "INSTRUMENT",
            "EXTERNAL_SOURCE",
            "OTHER",
            null
          ]
        },

        "role": {
          "type": [
            "string",
            "null"
          ]
        },

        "system_identifier": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "instrument_reference": {
      "type": [
        "object",
        "null"
      ],
      "description": "Measurement or test instrument information when applicable.",
      "additionalProperties": false,

      "properties": {
        "tool_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/tool_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "manufacturer_entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtime_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "product_entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtime_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "model": {
          "type": [
            "string",
            "null"
          ]
        },

        "serial_number": {
          "type": [
            "string",
            "null"
          ]
        },

        "calibration_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "CURRENT",
            "EXPIRED",
            "UNKNOWN",
            "NOT_APPLICABLE",
            null
          ]
        },

        "calibration_due_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "test_record": {
      "type": [
        "object",
        "null"
      ],
      "description": "Structured information about the deliberate technical test that produced the evidence.",
      "additionalProperties": false,

      "properties": {
        "test_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DIAGNOSTIC",
            "ISOLATION",
            "COMPARATIVE",
            "VALIDATION",
            "OTHER",
            null
          ]
        },

        "method": {
          "type": [
            "string",
            "null"
          ]
        },

        "conditions": {
          "type": [
            "string",
            "null"
          ]
        },

        "expected_result": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },

        "actual_result": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },

        "controlled_variable": {
          "type": [
            "string",
            "null"
          ]
        },

        "uncontrolled_variables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },

        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "change_result": {
      "type": [
        "object",
        "null"
      ],
      "description": "Structured linkage between evidence and a deliberate technical action or change.",
      "additionalProperties": false,

      "properties": {
        "action_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/action_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "before_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "after_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "outcome": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "IMPROVED",
            "DEGRADED",
            "UNCHANGED",
            "RESOLVED",
            "PARTIALLY_RESOLVED",
            "INCONCLUSIVE",
            "UNKNOWN",
            null
          ]
        },

        "other_material_changes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },

    "derivation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Structured derivation information for deterministic calculations and derived patterns.",
      "additionalProperties": false,

      "properties": {
        "derivation_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "DETERMINISTIC_CALCULATION",
            "STRUCTURED_PATTERN",
            "NORMALIZATION",
            "TRANSFORMATION",
            "OTHER",
            null
          ]
        },

        "method": {
          "type": [
            "string",
            "null"
          ]
        },

        "input_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "input_measurement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/measurement_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "reproducible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },

    "provenance": {
      "type": "object",
      "description": "Required lineage identifying what produced the evidence and how it entered A.R.I.A.",
      "additionalProperties": false,

      "required": [
        "origin_class"
      ],

      "properties": {
        "origin_class": {
          "type": "string",
          "enum": [
            "USER_SUPPLIED",
            "HUMAN_OBSERVED",
            "SYSTEM_OBSERVED",
            "MEASURED",
            "ARTIFACT_EXTRACTED",
            "SOURCE_DERIVED",
            "TEST_PRODUCED",
            "ACTION_PRODUCED",
            "SYSTEM_DERIVED"
          ]
        },

        "origin_actor_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtime_id"
            },
            {
              "type": "null"
            }
          ]
        },

        "origin_system": {
          "type": [
            "string",
            "null"
          ]
        },

        "origin_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "origin_artifact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "parent_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "transformation": {
          "type": [
            "string",
            "null"
          ],
          "description": "Transformation, extraction, normalization, calculation, or other processing applied between the original source and this evidence representation."
        },

        "captured_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "confidence": {
      "type": [
        "object",
        "null"
      ],
      "description": "Shared Core confidence shape. Confidence remains distinct from source authority, context-match confidence, and hypothesis probability.",
      "additionalProperties": false,

      "required": [
        "value",
        "basis"
      ],

      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },

        "basis": {
          "type": "string",
          "minLength": 1
        },

        "dimension": {
          "type": [
            "string",
            "null"
          ],
          "const": "EVIDENCE_CONFIDENCE"
        },

        "calculated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },

    "verification": {
      "type": [
        "object",
        "null"
      ],
      "description": "Independent verification of the underlying evidence when available.",
      "additionalProperties": false,

      "properties": {
        "verified": {
          "type": "boolean",
          "default": false
        },

        "verified_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/runtime_id"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },

        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },

        "verification_method": {
          "type": [
            "string",
            "null"
          ]
        },

        "verification_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_id"
          },
          "uniqueItems": true,
          "default": []
        },

        "verification_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },

    "diagnostic_link": {
      "type": "object",
      "description": "Case-specific relationship describing how this evidence currently affects a particular hypothesis.",
      "additionalProperties": false,

      "required": [
        "hypothesis_id",
        "role"
      ],

      "properties": {
        "hypothesis_id": {
          "$ref": "#/$defs/hypothesis_id"
        },

        "role": {
