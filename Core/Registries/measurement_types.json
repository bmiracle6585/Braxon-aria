  "comparison_modes": {
    "ACTUAL_VS_EXPECTED": "Compare a measured or reported value with an expected technical value.",
    "ACTUAL_VS_CONFIGURED": "Compare an observed value with the configured value.",
    "ACTUAL_VS_DESIGN": "Compare an observed or installed value with the engineered design.",
    "ACTUAL_VS_THRESHOLD": "Compare an observed value with an applicable limit or threshold.",
    "LOCAL_VS_REMOTE": "Compare corresponding measurements from opposite ends of a microwave path.",
    "MAIN_VS_DIVERSITY": "Compare corresponding measurements between Main and Diversity paths.",
    "BEFORE_VS_AFTER": "Compare values before and after a test, configuration change, repair, or corrective action."
  },

  "directionality": {
    "HIGHER_IS_BETTER": "Larger values generally represent improved technical condition.",
    "HIGHER_IS_STRONGER": "Larger numerical values represent stronger measured signal.",
    "LOWER_IS_BETTER": "Smaller values generally represent improved technical condition.",
    "LOWER_ABSOLUTE_IS_CLOSER": "Smaller absolute difference indicates closer agreement.",
    "LOWER_ABSOLUTE_DELTA_IS_BETTER": "Smaller angular or numerical deviation from the reference is preferred.",
    "EXACT_MATCH": "Values should match the applicable configured or engineered reference.",
    "EXACT_OR_RANGE_MATCH": "Value should equal or remain within an applicable allowed range.",
    "RANGE_DEPENDENT": "Acceptability depends upon defined minimum and maximum limits.",
    "CONTEXT_DEPENDENT": "The value cannot be classified as better or worse without additional technical context.",
    "NEUTRAL": "The measurement describes system context and does not independently imply quality."
  }
}
