{
  "registry": "ARIA_MEASUREMENT_TYPES",
  "version": "0.1.0",
  "description": "Controlled vocabulary defining canonical measurement types used by A.R.I.A. for microwave backhaul reasoning, evidence evaluation, comparison, and diagnostics.",

  "measurement_types": [
    {
      "type": "RSL",
      "canonical_name": "Received Signal Level",
      "category": "RF",
      "value_type": "NUMBER",
      "canonical_unit": "dBm",
      "directionality": "HIGHER_IS_STRONGER",
      "comparison_modes": [
        "ACTUAL_VS_EXPECTED",
        "LOCAL_VS_REMOTE",
        "MAIN_VS_DIVERSITY",
        "BEFORE_VS_AFTER"
      ],
      "description": "Received RF signal power measured at the receiver.",
      "aliases": [
        "Received Signal Level",
        "Receive Signal Level",
        "RX Level",
        "Rx Level"
      ]
    },

    {
      "type": "RSL_DELTA",
      "canonical_name": "RSL Delta",
      "category": "RF",
      "value_type": "NUMBER",
      "canonical_unit": "dB",
      "directionality": "LOWER_ABSOLUTE_IS_CLOSER",
      "comparison_modes": [
        "ACTUAL_VS_EXPECTED",
        "MAIN_VS_DIVERSITY",
        "LOCAL_VS_REMOTE"
      ],
      "description": "Difference between two RSL values or between measured and expected RSL."
    },

    {
      "type": "TX_POWER",
      "canonical_name": "Transmit Power",
      "category": "RF",
      "value_type": "NUMBER",
      "canonical_unit": "dBm",
      "directionality": "CONTEXT_DEPENDENT",
      "comparison_modes": [
        "ACTUAL_VS_CONFIGURED",
        "ACTUAL_VS_EXPECTED",
        "LOCAL_VS_REMOTE",
        "BEFORE_VS_AFTER"
      ],
      "description": "RF transmit power produced or reported by a radio."
    },

    {
      "type": "SNR",
      "canonical_name": "Signal-to-Noise Ratio",
      "category": "RF",
      "value_type": "NUMBER",
      "canonical_unit": "dB",
      "directionality": "HIGHER_IS_BETTER",
      "comparison_modes": [
        "ACTUAL_VS_THRESHOLD",
        "LOCAL_VS_REMOTE",
        "BEFORE_VS_AFTER"
      ],
      "description": "Ratio between desired received signal and noise."
    },

    {
      "type": "SINR",
      "canonical_name": "Signal-to-Interference-plus-Noise Ratio",
      "category": "RF",
      "value_type": "NUMBER",
      "canonical_unit": "dB",
      "directionality": "HIGHER_IS_BETTER",
      "comparison_modes": [
        "ACTUAL_VS_THRESHOLD",
        "LOCAL_VS_REMOTE",
        "BEFORE_VS_AFTER"
      ],
      "description": "Ratio of desired signal power to combined interference and noise."
