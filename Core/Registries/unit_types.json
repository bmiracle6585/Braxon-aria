{
  "registry": "ARIA_UNIT_TYPES",
  "version": "0.1.0",
  "description": "Controlled vocabulary defining canonical units used by A.R.I.A. for microwave backhaul measurements, calculations, comparisons, and evidence.",

  "units": [
    {
      "unit": "dBm",
      "canonical_name": "Decibel-Milliwatt",
      "symbol": "dBm",
      "category": "ABSOLUTE_POWER",
      "quantity": "POWER",
      "scale_type": "LOGARITHMIC_ABSOLUTE",
      "description": "Absolute power level referenced to 1 milliwatt.",
      "convertible_to": [
        "mW",
        "W"
      ],
      "notes": "dBm represents absolute power and must not be treated as equivalent to dB."
    },

    {
      "unit": "dB",
      "canonical_name": "Decibel",
      "symbol": "dB",
      "category": "RELATIVE_RATIO",
      "quantity": "RATIO",
      "scale_type": "LOGARITHMIC_RELATIVE",
      "description": "Logarithmic representation of a relative ratio, gain, loss, margin, or difference.",
      "convertible_to": [],
      "notes": "dB is relative and has no absolute power reference."
    },

    {
      "unit": "W",
      "canonical_name": "Watt",
      "symbol": "W",
      "category": "POWER",
      "quantity": "POWER",
      "scale_type": "LINEAR",
      "description": "SI unit of power.",
      "convertible_to": [
        "mW",
        "dBm"
      ]
    },

    {
      "unit": "mW",
      "canonical_name": "Milliwatt",
      "symbol": "mW",
      "category": "POWER",
      "quantity": "POWER",
      "scale_type": "LINEAR",
      "description": "One thousandth of a watt.",
      "convertible_to": [
        "W",
        "dBm"
      ]
    },

    {
      "unit": "Hz",
      "canonical_name": "Hertz",
      "symbol": "Hz",
      "category": "FREQUENCY",
      "quantity": "FREQUENCY",
      "scale_type": "LINEAR",
      "base_unit": true,
      "conversion_to_base": {
        "multiplier": 1
      }
    },

    {
      "unit": "kHz",
      "canonical_name": "Kilohertz",
      "symbol": "kHz",
      "category": "FREQUENCY",
      "quantity": "FREQUENCY",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "Hz",
        "multiplier": 1000
      }
    },

    {
      "unit": "MHz",
      "canonical_name": "Megahertz",
      "symbol": "MHz",
      "category": "FREQUENCY",
      "quantity": "FREQUENCY",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "Hz",
        "multiplier": 1000000
      }
    },

    {
      "unit": "GHz",
      "canonical_name": "Gigahertz",
      "symbol": "GHz",
      "category": "FREQUENCY",
      "quantity": "FREQUENCY",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "Hz",
        "multiplier": 1000000000
      }
    },

    {
      "unit": "bps",
      "canonical_name": "Bits per Second",
      "symbol": "bps",
      "category": "DATA_RATE",
      "quantity": "DATA_RATE",
      "scale_type": "LINEAR",
      "base_unit": true,
      "conversion_to_base": {
        "multiplier": 1
      }
    },

    {
      "unit": "kbps",
      "canonical_name": "Kilobits per Second",
      "symbol": "kbps",
      "category": "DATA_RATE",
      "quantity": "DATA_RATE",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "bps",
        "multiplier": 1000
      }
    },

    {
      "unit": "Mbps",
      "canonical_name": "Megabits per Second",
      "symbol": "Mbps",
      "category": "DATA_RATE",
      "quantity": "DATA_RATE",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "bps",
        "multiplier": 1000000
      }
    },

    {
      "unit": "Gbps",
      "canonical_name": "Gigabits per Second",
      "symbol": "Gbps",
      "category": "DATA_RATE",
      "quantity": "DATA_RATE",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "bps",
        "multiplier": 1000000000
      }
    },

    {
      "unit": "s",
      "canonical_name": "Second",
      "symbol": "s",
      "category": "TIME",
      "quantity": "TIME",
      "scale_type": "LINEAR",
      "base_unit": true,
      "conversion_to_base": {
        "multiplier": 1
      }
    },

    {
      "unit": "ms",
      "canonical_name": "Millisecond",
      "symbol": "ms",
      "category": "TIME",
      "quantity": "TIME",
      "scale_type": "LINEAR",
