      "canonical_name": "Ratio",
      "symbol": null,
      "category": "DIMENSIONLESS",
      "quantity": "RATIO",
      "scale_type": "LINEAR",
      "description": "Dimensionless numerical ratio."
    },

    {
      "unit": "COUNT",
      "canonical_name": "Count",
      "symbol": null,
      "category": "DIMENSIONLESS",
      "quantity": "COUNT",
      "scale_type": "DISCRETE",
      "description": "Integer count of occurrences or events."
    },

    {
      "unit": "V",
      "canonical_name": "Volt",
      "symbol": "V",
      "category": "ELECTRICAL",
      "quantity": "VOLTAGE",
      "scale_type": "LINEAR"
    },

    {
      "unit": "A",
      "canonical_name": "Ampere",
      "symbol": "A",
      "category": "ELECTRICAL",
      "quantity": "CURRENT",
      "scale_type": "LINEAR"
    },

    {
      "unit": "C",
      "canonical_name": "Degrees Celsius",
      "symbol": "°C",
      "category": "TEMPERATURE",
      "quantity": "TEMPERATURE",
      "scale_type": "OFFSET_LINEAR",
      "description": "Temperature expressed on the Celsius scale."
    },

    {
      "unit": "F",
      "canonical_name": "Degrees Fahrenheit",
      "symbol": "°F",
      "category": "TEMPERATURE",
      "quantity": "TEMPERATURE",
      "scale_type": "OFFSET_LINEAR",
      "description": "Temperature expressed on the Fahrenheit scale."
    },

    {
      "unit": "mph",
      "canonical_name": "Miles per Hour",
      "symbol": "mph",
      "category": "SPEED",
      "quantity": "SPEED",
      "scale_type": "LINEAR",
      "conversion_to_si": {
        "unit": "m/s",
        "multiplier": 0.44704
      }
    },

    {
      "unit": "m/s",
      "canonical_name": "Meters per Second",
      "symbol": "m/s",
      "category": "SPEED",
      "quantity": "SPEED",
      "scale_type": "LINEAR"
    },

    {
      "unit": "mm/h",
      "canonical_name": "Millimeters per Hour",
      "symbol": "mm/h",
      "category": "PRECIPITATION_RATE",
      "quantity": "PRECIPITATION_RATE",
      "scale_type": "LINEAR"
    }
  ],

  "special_conversions": [
    {
      "from": "dBm",
      "to": "mW",
      "formula": "10^(dBm/10)",
      "description": "Convert absolute logarithmic power in dBm to milliwatts."
    },

    {
      "from": "mW",
      "to": "dBm",
      "formula": "10*log10(mW)",
      "constraints": [
        "mW > 0"
      ]
    },

    {
      "from": "dBm",
      "to": "W",
      "formula": "10^((dBm-30)/10)"
    },

    {
      "from": "W",
      "to": "dBm",
      "formula": "10*log10(W)+30",
      "constraints": [
        "W > 0"
      ]
    },

    {
      "from": "C",
      "to": "F",
      "formula": "(C*9/5)+32"
    },

    {
      "from": "F",
      "to": "C",
      "formula": "(F-32)*5/9"
    }
  ],

  "semantic_rules": [
    {
      "rule_id": "UNIT-RULE-001",
      "rule": "dBm represents absolute power. dB represents a relative ratio, gain, loss, margin, or difference. They shall never be treated as interchangeable units."
    },

    {
      "rule_id": "UNIT-RULE-002",
      "rule": "Subtracting two dBm power levels produces a difference expressed in dB, not dBm."
    },

    {
      "rule_id": "UNIT-RULE-003",
      "rule": "For negative dBm values, the numerically greater value represents greater absolute power. For example, -50 dBm is stronger than -70 dBm."
    },

    {
      "rule_id": "UNIT-RULE-004",
      "rule": "Unit conversion shall not change the underlying physical quantity represented by the measurement."
    },

    {
      "rule_id": "UNIT-RULE-005",
      "rule": "Comparisons between measurements shall be performed only when their physical quantities are compatible or an explicit transformation defines the comparison."
    },

    {
      "rule_id": "UNIT-RULE-006",
      "rule": "Angular differences shall account for circular wraparound. For example, the smallest difference between 359 degrees and 1 degree is 2 degrees, not 358 degrees."
    },

    {
      "rule_id": "UNIT-RULE-007",
      "rule": "Percentage and ratio representations shall be normalized before mathematical comparison when they use different scales."
    }
  ]
}
