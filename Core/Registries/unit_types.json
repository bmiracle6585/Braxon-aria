        "unit": "s",
        "multiplier": 0.000001
      }
    },

    {
      "unit": "m",
      "canonical_name": "Meter",
      "symbol": "m",
      "category": "DISTANCE",
      "quantity": "LENGTH",
      "scale_type": "LINEAR",
      "base_unit": true,
      "conversion_to_base": {
        "multiplier": 1
      }
    },

    {
      "unit": "km",
      "canonical_name": "Kilometer",
      "symbol": "km",
      "category": "DISTANCE",
      "quantity": "LENGTH",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "m",
        "multiplier": 1000
      }
    },

    {
      "unit": "ft",
      "canonical_name": "Foot",
      "symbol": "ft",
      "category": "DISTANCE",
      "quantity": "LENGTH",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "m",
        "multiplier": 0.3048
      }
    },

    {
      "unit": "mi",
      "canonical_name": "Mile",
      "symbol": "mi",
      "category": "DISTANCE",
      "quantity": "LENGTH",
      "scale_type": "LINEAR",
      "conversion_to_base": {
        "unit": "m",
        "multiplier": 1609.344
      }
    },

    {
      "unit": "DEGREES",
      "canonical_name": "Degree",
      "symbol": "°",
      "category": "ANGLE",
      "quantity": "ANGLE",
      "scale_type": "CIRCULAR",
      "description": "Angular measurement where one full rotation equals 360 degrees.",
      "normalization": {
        "minimum": 0,
        "maximum_exclusive": 360
      }
    },

    {
      "unit": "PERCENT",
      "canonical_name": "Percent",
      "symbol": "%",
      "category": "DIMENSIONLESS",
